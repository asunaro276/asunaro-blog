---
import Layout from "../layouts/Layout.astro";
import HomePage from "../components/HomePage/index.astro";
import { AstroSeo } from "@astrolib/seo";
import { DIContainer } from "/infrastructure/di/DIContainer";
import { Page } from "/domain/models/page/Page";

const page = new Page(1);
const getArticleList = DIContainer.createGetArticleList();
const {
	articles,
	categories,
	tags,
	yearmonths,
	currentPage,
	currentPath,
	totalCount,
} = await getArticleList.execute({ page });
---

<AstroSeo
	title="Asunaro Blog"
	description="一ソフトウェアエンジニアの技術ブログです。考えたことや技術で遊んだ記録を書いています。"
	openGraph={{
		title: "Asunaro Blog",
		description:
			"一ソフトウェアエンジニアの技術ブログです。考えたことや技術で遊んだ記録を書いています。",
		images: [
			{
				url: "https://storage.googleapis.com/p_641d41d3a492e5ac4c9226fe/3ab0e1e0-e610-4dc9-acb4-f7917add37b1/asunaro.png",
			},
		],
	}}
/>
<Layout>
	<main>
		<HomePage
			articles={articles}
			categories={categories}
			tags={tags}
			yearmonths={yearmonths}
			currentPage={currentPage}
			currentPath={currentPath}
			totalCount={totalCount}
		/>
	</main>
</Layout>
